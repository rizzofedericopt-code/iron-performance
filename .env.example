# Copia in .env per lo sviluppo locale (`vercel dev`).
# In produzione questi valori si impostano nel pannello Vercel → Settings → Environment Variables.
# .env NON va mai committato: è già in .gitignore.

# Connessione al database (la fornisce Vercel Postgres / Neon)
POSTGRES_URL=

# Codice di invito richiesto per creare un account.
# È un unico segreto condiviso: se gira, chiunque può registrarsi. Cambialo se lo sospetti.
IP_SIGNUP_CODE=

# Origine autorizzata per le chiamate API
IP_ALLOWED_ORIGIN=https://iron-performance.vercel.app

# URL dell'app, usato per costruire il link nelle email di reset
IP_APP_URL=https://iron-performance.vercel.app

# Invio email di recupero password (resend.com)
RESEND_API_KEY=
RESEND_FROM=Iron Performance <no-reply@tuodominio.it>
